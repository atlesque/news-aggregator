{
  "name": "news-aggregator",
  "private": true,
  "license": "MIT",
  "description": "A calm, AI-summarised local news front page and API on Cloudflare Workers, D1, Workflows and Workers AI.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "dev:web": "nuxt dev",
    "build": "nuxt generate",
    "deploy": "nuxt generate && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --strict-vars=false",
    "test": "node --test \"test/*.test.ts\"",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.144",
    "@nuxt/ui": "^4.12.0",
    "@types/node": "^26.6.5",
    "nuxt": "^4.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "wrangler": "^4.150.0"
  }
}
