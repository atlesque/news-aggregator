{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "news-aggregator",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  "routes": [{ "pattern": "news.atlesque.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,

  // The front end (a Nuxt app, built by `nuxt generate` into .output/public) and the admin
  // shell are static assets: served from the edge without running the Worker, so they cost
  // nothing and don't count against the free plan's 100k requests/day. Only the JSON/RSS
  // endpoints, story pictures (/img/*, from R2) and /admin run the Worker. Page paths such as /local and /story/12 get the
  // app's index.html, and the app routes them in the browser.
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/*", "/admin", "/admin/*"],
    "not_found_handling": "single-page-application"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "news-aggregator",
      "database_id": "4803e069-e6d1-4612-8e94-f16b303927d4",
      "migrations_dir": "migrations"
    }
  ],

  // One picture per story, copied in by the refresh and served at /img/<key>. The refresh
  // deletes pictures with their stories (three-day rolling window, see RETENTION_DAYS).
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "news-aggregator-images" }],

  // Summaries, translation, ranking (text model) and deduplication (embeddings).
  "ai": { "binding": "AI" },

  // The refresh, at 6:07, 12:07, 16:07 and 20:07 Brussels time. Crons run in UTC, so each time
  // fires at both its summer (CEST) and winter (CET) UTC hour; scheduled() skips the wrong one.
  // Each source fetch, embedding batch and AI batch is its own step,
  // so every step stays well inside the free plan's 10 ms CPU budget and retries on its own.
  "workflows": [{ "name": "news-refresh", "binding": "REFRESH", "class_name": "RefreshWorkflow" }],
  "triggers": { "crons": ["7 4,5,10,11,14,15,18,19 * * *"] },

  // Per-API-key limit (per Cloudflare location). Must be 10 or 60 seconds.
  "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "4201", "simple": { "limit": 30, "period": 60 } }],

  "vars": {
    "SITE_URL": "https://news.atlesque.dev",
    // Cloudflare Access application covering /admin and /api/admin/* on this hostname.
    // ACCESS_AUD is its "Application Audience (AUD) Tag". While either is empty, admin is off.
    "ACCESS_TEAM_DOMAIN": "https://atlesque.cloudflareaccess.com",
    "ACCESS_AUD": "58b935efe8a84445f2960af96a4a9df981a3f0f633939db6284f4779f00a092a",
    // Optional comma-separated allow-list on top of the Access policy. Empty = whoever Access lets in.
    "ADMIN_EMAILS": "alexander@atlesque.media"
  }
}
